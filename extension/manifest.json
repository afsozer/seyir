{
  "manifest_version": 3,
  "name": "Seyir",
  "version": "0.1.1",
  "description": "opencode ajanına tarayıcını oturumlarınla kullandırır: kendi sekme grubunda gezinir, okur, tıklar, yazar.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "scripting",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Seyir",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "ikon/16.png",
      "32": "ikon/32.png",
      "48": "ikon/48.png"
    }
  },
  "icons": {
    "16": "ikon/16.png",
    "48": "ikon/48.png",
    "128": "ikon/128.png"
  }
}
